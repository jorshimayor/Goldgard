{
  "name": "@stradebase/api",
  "version": "0.1.0",
  "description": "Unified Stradebase backend API: mint/transfer SBTS, accept/transfer USDC & USDT, balances, history, and admin freeze/thaw.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "indexer": "tsx src/indexer/index.ts",
    "signer": "tsx src/signing/service-main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "tsx test/e2e.ts",
    "royalties-e2e": "tsx test/royalties-e2e.ts",
    "burst": "tsx test/burst.ts",
    "pii": "tsx test/pii.ts",
    "unified-test": "tsx test/unified.ts",
    "pgstore-test": "tsx test/pgstore.ts",
    "indexer-test": "tsx test/indexer.ts",
    "signer-e2e": "tsx test/signer-e2e.ts",
    "apitest": "tsx test/apitest.ts"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.1.1",
    "@metaplex-foundation/umi": "^1.0.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.0.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.0.0",
    "@anchor-lang/core": "^1.1.2",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@stradebase/blockchain": "workspace:*",
    "@stradebase/onchain": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
